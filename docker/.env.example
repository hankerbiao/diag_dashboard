# cp .env.example .env 后编辑

BACKEND_PORT=8000
FRONTEND_PORT=3000

# 浏览器访问 API 的地址（从其他机器访问时改为 http://<宿主机IP>:8000）
VITE_API_BASE_URL=http://localhost:8000

MONGODB_DB_NAME=diag_analysis

JWT_SECRET_KEY=change-this-to-a-random-64-character-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

OPENAI_API_KEY=
OPENAI_API_URL=
AI_MODEL=gpt-4-turbo
AI_TEMPERATURE=0.7
GEMINI_API_KEY=

RAGFLOW_API_URL=
RAGFLOW_API_KEY=
