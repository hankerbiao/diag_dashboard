# cp .env.example .env 后编辑

BACKEND_PORT=8000
FRONTEND_PORT=3000

# 浏览器访问 API 的地址（从其他机器访问时改为 http://<宿主机IP>:8000）
VITE_API_BASE_URL=http://localhost:8000

MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=diag_analysis

JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OA_JWT_SECRET=replace-with-springboard-shared-secret
OA_APP_NAME=diagweaveeye
OA_LOGIN_BASE_URL=http://tl.cooacloud.com/springboard_v3/login_proxy
# Prefer the HTTPS Springboard endpoint when available.
VITE_OA_LOGIN_URL=http://tl.cooacloud.com/springboard_v3/login_proxy/diagweaveeye

OPENAI_API_KEY=
OPENAI_API_URL=
AI_MODEL=gpt-4-turbo
AI_TEMPERATURE=0.7
GEMINI_API_KEY=

RAGFLOW_API_URL=
RAGFLOW_API_KEY=
RAGFLOW_DEFAULT_DATASET=weaveeye-knowledge-base
RAGFLOW_TROUBLESHOOTING_DATASET=weaveeye-troubleshooting
RAGFLOW_REPAIR_CASE_DATASET=weaveeye-repair-cases
RAGFLOW_OPERATION_GUIDE_DATASET=weaveeye-operation-guides
RAGFLOW_FAQ_DATASET=weaveeye-faq

DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE=

MES_REQUEST_TIMEOUT=30
