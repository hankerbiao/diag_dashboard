# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=diag_analysis

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-random-64-character-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Providers
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key

# RAGFlow - 知识库引擎
RAGFLOW_API_URL=http://your-ragflow-server:9380
RAGFLOW_API_KEY=your-ragflow-api-key
RAGFLOW_DEFAULT_DATASET=weaveeye-knowledge-base
RAGFLOW_TROUBLESHOOTING_DATASET=weaveeye-troubleshooting
RAGFLOW_REPAIR_CASE_DATASET=weaveeye-repair-cases
RAGFLOW_OPERATION_GUIDE_DATASET=weaveeye-operation-guides
RAGFLOW_FAQ_DATASET=weaveeye-faq

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Docker / custom layout (optional; default: <repo>/scripts)
# SCRIPTS_DIR=/app/scripts
# FACTORIES_YAML_PATH=/etc/weaveeye/factories.yaml
# KNOWLEDGE_BASE_STORAGE_PATH=/data/knowledge_base
# 数据同步在 API 外执行: python scripts/weaveeye_sync.py run

# Sync Module - 三方数据同步
SYNC_API_BASE_URL=http://10.2.68.103
SYNC_API_TIMEOUT=30
SYNC_MAX_CONCURRENCY=5
SYNC_MAX_RETRIES=3
